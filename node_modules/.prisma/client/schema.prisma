generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  ADMIN
  CEO
  CENTRE
  TEACHER
  GRADER
  SUPPORT
  CONTENT
  ANALYST
  MANAGER
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TaskLabel {
  CUSTOMER_SERVICE
  TECHNICAL_ANALYSIS
  CONTENT_MANAGEMENT
  OPERATIONS
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum DeviceType {
  DESKTOP
  LAPTOP
  MOBILE
  TABLET
}

enum TestType {
  READING
  LISTENING
  WRITING
  SPEAKING
}

enum PracticeMode {
  FULL
  PARTIAL
}

enum QuestionType {
  MULTIPLE_CHOICE
  FILL_BLANKS
  TRUE_FALSE
}

enum ReportType {
  CONTENT_ERROR
  TECHNICAL_BUG
  SCORE_ERROR
  TYPO
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  WONT_FIX
}

enum GroupLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum GroupStatus {
  OPEN
  CLOSED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ─────────────────────────────────────────────────────────────
// Core Identity
// ─────────────────────────────────────────────────────────────

model User {
  id                  Int       @id @default(autoincrement())
  full_name           String
  email               String    @unique
  username            String?   @unique
  password            String
  country             String?
  phone               String?
  test_type           String?
  role                Role      @default(STUDENT)
  is_verified         Boolean   @default(false)
  is_onboarded        Boolean   @default(false)
  target_band         Float?    @default(8.0)
  current_band        Float     @default(5.0)
  study_hours         Float     @default(0)
  tasks_done          Int       @default(0)
  weekly_goal_percent Float     @default(0)
  exam_date           DateTime?
  exam_date_text      String?
  target_band_range   String?
  study_commitment    String?
  referral_source     String?
  isActive            Boolean   @default(true)
  lastSeenAt          DateTime?

  // Onboarding fields
  isExamDateUnsure   Boolean @default(true)
  sourceOfExposure   String? // Friend, Social Media, Presentations, Other
  onboardingComplete Boolean @default(false)

  // Relations mapped by Role
  centreId Int?
  centre   EducationCentre? @relation(fields: [centreId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Student Relations
  typingResults  TypingResult[]
  studyStreaks   StudyStreak[]
  weeklyProgress WeeklyProgress[]
  reports        Report[]           @relation("ReportsSubmitted")
  mockResults    MockResult[]
  aiChats        AiChatSession[]
  applications   GroupApplication[]

  // Teacher Relations
  lessons      Lesson[]     @relation("TeacherLessons")
  materials    Material[]   @relation("TeacherMaterials")
  followers    Follow[]     @relation("Followers")
  following    Follow[]     @relation("Following")
  taughtGroups StudyGroup[] @relation("TeacherGroups")

  // Admin Relations
  devices             Device[]
  tasksAssigned       AdminTask[]
  createdTests        PracticeTest[]       @relation("TestsCreated")
  resolvedReports     Report[]             @relation("ReportsResolved")
  loginLogs           LoginLog[]
  practiceTestResults PracticeTestResult[]
  testUnlocks         TestUnlock[]
  progressSnapshots   ProgressSnapshot[]
  passwordResets      PasswordResetToken[]
}

// ─────────────────────────────────────────────────────────────
// Education Centre Operations
// ─────────────────────────────────────────────────────────────

model EducationCentre {
  id           Int     @id @default(autoincrement())
  name         String
  code         String  @unique
  city         String
  district     String?
  address      String?
  contactEmail String?
  contactPhone String?
  websiteUrl   String?

  totalStudents  Int     @default(0)
  activeStudents Int     @default(0)
  rating         Float?  @default(0.0)
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff        User[]
  mockSessions MockSession[]
  studyGroups  StudyGroup[]
  inquiries    Inquiry[]

  @@index([city])
  @@index([code])
}

model PartnerRequest {
  id          Int           @id @default(autoincrement())
  centre_name String
  ceo_name    String
  email       String        @unique
  phone       String
  location    String
  status      PartnerStatus @default(PENDING)
  password    String
  createdAt   DateTime      @default(now())
}

model MockSession {
  id       Int             @id @default(autoincrement())
  centreId Int
  centre   EducationCentre @relation(fields: [centreId], references: [id], onDelete: Cascade)
  dateTime DateTime
  type     String          @default("Academic") // Academic / General
  format   String          @default("Paper-Based") // Paper / Computer
  location String          @default("TBD")
  capacity Int             @default(30)
  price    Float           @default(0)
  notes    String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results MockResult[]
}

model MockResult {
  id        Int          @id @default(autoincrement())
  studentId Int
  student   User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId Int?
  session   MockSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  listening Float?
  reading   Float?
  writing   Float?
  speaking  Float?
  overall   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudyGroup {
  id        Int             @id @default(autoincrement())
  centreId  Int
  centre    EducationCentre @relation(fields: [centreId], references: [id], onDelete: Cascade)
  teacherId Int?
  teacher   User?           @relation("TeacherGroups", fields: [teacherId], references: [id])

  name        String
  level       String      @default("All levels")
  schedule    String      @default("TBD")
  startDate   DateTime?
  endDate     DateTime?
  capacity    Int         @default(15)
  status      GroupStatus @default(OPEN)
  description String?     @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications GroupApplication[]
}

model GroupApplication {
  id        Int               @id @default(autoincrement())
  studentId Int
  student   User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId   Int
  group     StudyGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status    ApplicationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, groupId])
}

model Inquiry {
  id           Int             @id @default(autoincrement())
  centreId     Int
  centre       EducationCentre @relation(fields: [centreId], references: [id], onDelete: Cascade)
  studentName  String
  studentEmail String
  message      String          @db.Text
  isRead       Boolean         @default(false)
  createdAt    DateTime        @default(now())
}

// ─────────────────────────────────────────────────────────────
// Admin & CEO
// ─────────────────────────────────────────────────────────────

model AdminTask {
  id      Int  @id @default(autoincrement())
  adminId Int
  admin   User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  title        String
  notes        String?      @db.Text
  label        TaskLabel    @default(CUSTOMER_SERVICE)
  priority     TaskPriority @default(MEDIUM)
  isDone       Boolean      @default(false)
  doneAt       DateTime?
  assignedDate DateTime     @default(now()) @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId])
  @@index([isDone])
}

model Device {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceType DeviceType @default(DESKTOP)
  deviceName String
  browser    String
  os         String?

  ipAddress String?
  location  String?
  latitude  Float?
  longitude Float?

  userAgent    String?  @db.Text
  isActive     Boolean  @default(true)
  lastActiveAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model StrategicGoal {
  id       Int          @id @default(autoincrement())
  title    String
  priority TaskPriority @default(MEDIUM)
  column   String       @default("TODO")
  dueDate  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        Int      @id @default(autoincrement())
  icon      String   @default("🔔")
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model LoginLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress  String?
  deviceInfo String?
  userAgent  String?  @db.Text
  success    Boolean
  reason     String?
  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
}

// ─────────────────────────────────────────────────────────────
// Student Practice & Records
// ─────────────────────────────────────────────────────────────

model TypingResult {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wpm             Float
  accuracy        Float
  date            DateTime @default(now())
  durationMinutes Int?     @default(2)
}

model StudyStreak {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  isCompleted Boolean  @default(false)

  @@unique([userId, date])
}

model WeeklyProgress {
  id                 Int      @id @default(autoincrement())
  userId             Int
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStartDate      DateTime @db.Date
  perfectScoresCount Int      @default(0)
  progressPercentage Float    @default(0)

  @@unique([userId, weekStartDate])
}

model AiChatSession {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic        String   @default("General")
  messageCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  history Json?
}

// ─────────────────────────────────────────────────────────────
// Testing & Content Generation
// ─────────────────────────────────────────────────────────────

model PracticeTest {
  id           Int          @id @default(autoincrement())
  title        String
  testType     TestType
  practiceMode PracticeMode @default(FULL)
  focusArea    String?
  durationMins Int          @default(60)
  instructions String?      @db.Text
  passage      String?      @db.Text
  audioUrl     String?
  isPublished  Boolean      @default(false)
  isArchived   Boolean      @default(false)

  createdById Int
  createdBy   User @relation("TestsCreated", fields: [createdById], references: [id])

  questions Question[]
  reports   Report[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  practiceTestResults PracticeTestResult[]

  @@index([testType])
}

model Question {
  id            Int          @id @default(autoincrement())
  testId        Int
  test          PracticeTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionText  String       @db.Text
  type          QuestionType @default(MULTIPLE_CHOICE)
  options       Json?
  correctAnswer String
  orderIndex    Int          @default(0)

  reports Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Report {
  id          Int          @id @default(autoincrement())
  studentId   Int
  student     User         @relation("ReportsSubmitted", fields: [studentId], references: [id])
  testId      Int
  test        PracticeTest @relation(fields: [testId], references: [id])
  questionId  Int?
  question    Question?    @relation(fields: [questionId], references: [id])
  type        ReportType   @default(CONTENT_ERROR)
  status      ReportStatus @default(OPEN)
  description String       @db.Text

  resolvedById   Int?
  resolvedBy     User?     @relation("ReportsResolved", fields: [resolvedById], references: [id])
  resolutionNote String?   @db.Text
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Test Progression System - Student Results & Unlock Tracking
// ─────────────────────────────────────────────────────────────

model PracticeTestResult {
  id     Int          @id @default(autoincrement())
  userId Int
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId Int
  test   PracticeTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  // Test identification (for HTML-based tests without DB entries)
  testIdentifier  String  @db.Text // e.g., "listening-full-set1", "reading-part1-set5"
  testCategory    String // "Listening", "Reading", "Writing", "Speaking"
  testSubcategory String? // "Full", "Part1", "Part2", "Part3", "All Passages", "All Tasks"
  setNumber       Int // 1-10

  // Score tracking
  score            Float  @default(0) // Percentage 0-100
  bandScore        Float? // IELTS band 1-9
  correctAnswers   Int    @default(0)
  totalQuestions   Int    @default(0)
  timeSpentSeconds Int    @default(0)

  // Answer details stored as JSON
  answers Json? // { questionIndex: { selected: "A", correct: "B", isCorrect: false } }

  // Progression tracking
  isCompleted Boolean   @default(false)
  isUnlocked  Boolean   @default(true) // For level-gating
  completedAt DateTime?

  // AI Analysis fields
  aiAnalysis   String? @db.Text // AI-generated insights about performance
  progressNote String? @db.Text // Human-readable progress note

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, testIdentifier])
  @@index([userId])
  @@index([testCategory])
  @@index([testIdentifier])
}

// Track level unlocks per category
model TestUnlock {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  category       String // "Listening", "Reading", "Writing", "Speaking"
  subcategory    String? // "Full", "Part1", etc.
  maxUnlockedSet Int     @default(1) // Highest set number unlocked (1-10)

  // Requirements to unlock next level
  minScoreRequired Float @default(70.0) // Default 70% to unlock next

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category, subcategory])
}

// Student progress summary for AI analysis
model ProgressSnapshot {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Category averages
  listeningAvg Float? @default(0)
  readingAvg   Float? @default(0)
  writingAvg   Float? @default(0)
  speakingAvg  Float? @default(0)
  overallAvg   Float? @default(0)

  // Band estimates
  estimatedBand Float? @default(5.0)
  targetBand    Float? @default(8.0)

  // Progress tracking
  testsCompleted Int     @default(0)
  currentStreak  Int     @default(0)
  bestStreak     Int     @default(0)
  weakAreas      String? @db.Text // JSON: ["Listening-Part2", "Reading-Part3"]
  strongAreas    String? @db.Text // JSON: ["Writing-Task1"]

  // AI Conclusion
  isMakingProgress Boolean @default(true)
  aiConclusion     String? @db.Text // Full AI analysis text
  recommendation   String? @db.Text // What to practice next

  snapshotDate DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([snapshotDate])
}

// ─────────────────────────────────────────────────────────────
// Teacher Operations
// ─────────────────────────────────────────────────────────────

model Lesson {
  id        Int        @id @default(autoincrement())
  title     String
  zoomLink  String
  startTime DateTime
  status    String     @default("SCHEDULED")
  teacherId Int
  teacher   User       @relation("TeacherLessons", fields: [teacherId], references: [id], onDelete: Cascade)
  materials Material[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Material {
  id        Int      @id @default(autoincrement())
  fileName  String
  fileUrl   String
  fileType  String
  teacherId Int
  teacher   User     @relation("TeacherMaterials", fields: [teacherId], references: [id], onDelete: Cascade)
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  lessonId  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Follow {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   User     @relation("Following", fields: [studentId], references: [id], onDelete: Cascade)
  teacherId Int
  teacher   User     @relation("Followers", fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([studentId, teacherId])
}

// Utilities
model VerificationCode {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
