STEP 2: UPDATE completeDojo() METHOD (around line 2705)
================================================================================

Replace the entire completeDojo() method with:

                    async completeDojo() {
                        if(this.dojoCompleted) return;
                        this.dojoCompleted = true;
                        this.dojoEndTime = Date.now();
                        if(this.dojoTimerInterval) {
                            clearInterval(this.dojoTimerInterval);
                            this.dojoTimerInterval = null;
                        }
                        this.calculateDojoStats();
                        console.log('🎯 Typing Dojo completed!', { wpm: this.dojoWpm, accuracy: this.dojoAcc, errors: this.dojoErrors });

                        // Save to localStorage for immediate display in Dojo History
                        const durationSeconds = Math.floor((this.dojoEndTime - this.dojoStartTime) / 1000);
                        const newEntry = {
                            date: new Date().toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }),
                            duration: durationSeconds + 's',
                            level: this.dojoDifficulty.charAt(0).toUpperCase() + this.dojoDifficulty.slice(1),
                            wpm: this.dojoWpm,
                            accuracy: Math.round(this.dojoAcc) + '%',
                            result: this.dojoHistory.length === 0 || this.dojoWpm > Math.max(...this.dojoHistory.map(h => h.wpm || 0)) ? 'Personal Best' : 'Completed'
                        };
                        this.dojoHistory.unshift(newEntry);
                        if (this.dojoHistory.length > 10) this.dojoHistory.pop();
                        localStorage.setItem('dojo_history', JSON.stringify(this.dojoHistory));

                        // Save results to database
                        try {
                            const token = localStorage.getItem('token') || localStorage.getItem('ielts_token');
                            if (!token) {
                                console.warn('No auth token found, cannot save typing result');
                                return;
                            }

                            const durationMinutes = Math.ceil((this.dojoEndTime - this.dojoStartTime) / 60000) || 1;

                            const response = await fetch('/api/typing/submit', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'Authorization': `Bearer ${token}`
                                },
                                body: JSON.stringify({
                                    wpm: this.dojoWpm,
                                    accuracy: this.dojoAcc,
                                    durationMinutes: durationMinutes,
                                    difficulty: this.dojoDifficulty
                                })
                            });

                            const data = await response.json();
                            if (data.success) {
                                console.log('✅ Typing result saved to database!', data.data);
                                this.showNotification && this.showNotification(`Typing completed! ${this.dojoWpm} WPM saved to leaderboard!`);
                            } else {
                                console.error('❌ Failed to save typing result:', data.message);
                            }
                        } catch (err) {
                            console.error('❌ Error saving typing result:', err);
                        }
                    },


