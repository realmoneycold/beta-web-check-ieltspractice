# ═══════════════════════════════════════════════════════════
# IELTSPRACTICE — Environment Variables Template
# Copy this file to .env and replace with actual secure values
# ═══════════════════════════════════════════════════════════

# ─── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://username:password@host:port/database?schema=public"

# ─── Authentication ────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secure-jwt-secret-min-64-chars-here"

# ─── Email Service (Resend) ────────────────────────────────
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="IELTS Practice <noreply@yourdomain.com>"

# ─── Frontend URL ──────────────────────────────────────────
# Used for email links (password reset, verification)
FRONTEND_URL="http://localhost:4000"

# ─── Google Gemini AI ──────────────────────────────────────
GEMINI_API_KEY="your-actual-gemini-api-key-here"

# ─── Groq AI ───────────────────────────────────────────────
# Get your API key at https://console.groq.com/keys
# Used for IELTS writing assessment and AI mentoring
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ─── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"
LOG_LEVEL="info"

# ─── CORS Configuration ───────────────────────────────────
CORS_ORIGIN="http://localhost:4000"

# ─── Monitoring (Optional) ────────────────────────────────
SENTRY_DSN="your-sentry-dsn-here"

# ─── Cloudflare R2 Storage (Optional — future) ────────────
# CLOUDFLARE_R2_ACCESS_KEY="your-r2-access-key"
# CLOUDFLARE_R2_SECRET_KEY="your-r2-secret-key"
# CLOUDFLARE_R2_BUCKET="your-bucket-name"
# CLOUDFLARE_R2_ACCOUNT_ID="your-account-id"
